# The terminal palette, ported verbatim from the operator's macOS kitty config. kitty (modules/kitty.nix) and
# Konsole (modules/konsole.nix) both use it, so the two terminals look the same. colors: 0–7 normal, 8–15 bright.
{
  foreground = "#7E3462";
  background = "#F6F2EE";
  cursor = "#3D2B5A";
  selectionForeground = "#BAB5BF";
  selectionBackground = "#3E2B5A";
  colors = [
    "#1e1e1e"
    "#f7768e"
    "#69c05c"
    "#ffcc99"
    "#3a8fff"
    "#9ea0dd"
    "#0aaab3"
    "#bfc2da"
    "#444b6a"
    "#ff7a93"
    "#9ece6a"
    "#ffbd49"
    "#66ccff"
    "#c89bb9"
    "#56b6c2"
    "#d2d7ff"
  ];
}
